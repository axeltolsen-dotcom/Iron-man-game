  "rebindable_rows": {
    "_note": "One row per player-mappable mapping. mapping_name is the STABLE id saved in the user's key profile (never the localized label). device: kbm | pad, one mapping name per (action, device) so conflict checks stay inside one device family. phase A = already an Enhanced Input action in IMC_IronMan; B = polled today, must go through ArenaInput::KeyFor() / a new IA; C = vehicle context (optional).",
    "contexts": {
      "Core": "IMC_IronMan + on-foot/flight career keys; all active together, so duplicates are conflicts.",
      "Vehicle": "UCareerInput::TickVehicle; active only while driving; may reuse Core keys (W/S/Space/Ctrl/Shift/X/Q/E) on purpose.",
      "Menu": "Widget NativeOnKeyDown; fixed."
    },
