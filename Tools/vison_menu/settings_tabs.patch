+
+void USettingsWidget::SelectTab(int32 Index)
+{
+	if (!TabSwitcher) { return; }
+	Index = FMath::Clamp(Index, 0, TabSwitcher->GetChildrenCount() - 1);
+	LastTab = Index;
+	TabSwitcher->SetActiveWidgetIndex(Index);
+	if (TabScroll) { TabScroll->ScrollToStart(); }
+	for (int32 i = 0; i < TabButtons.Num(); ++i)
+	{
+		if (TabButtons[i]) { TabButtons[i]->SetBackgroundColor(i == Index ? ArenaUI::ButtonBgSelected : ArenaUI::ButtonBg); }
+		if (TabLabels.IsValidIndex(i) && TabLabels[i]) { TabLabels[i]->SetColorAndOpacity(FSlateColor(i == Index ? FLinearColor::White : ArenaUI::Gold)); }
+	}
 }
 
+void USettingsWidget::HandleTabVideo() { SelectTab(0); }
