{
  "metadata": {
    "name": "Vison camera color grade",
    "version": "1.0.0",
    "date": "2026-10-30",
    "generated_by": "gen_camera_realism.py",
    "composition": "look values are deltas on top of each environment's lighting_presets grade: Saturation/Contrast/Gamma/Gain multiply per channel, Offset/Vignette/Grain add, everything else sets. ColorSaturation result clamped to <= 1.0 (ApplyPhotorealGrade); composed ColorGain* R/G/B clamped to 0.95-1.05 and ColorOffset* R/G/B to +-0.006 (keeps looks subtle).",
    "keys": "C++ FPostProcessSettings names (apply script converts to snake_case)"
  },
  "tonemapper": {
    "sdr_default": {
      "TonemappingMethod": "Filmic",
      "why": "keeps the per-environment Film Slope/Toe/Shoulder/BlackClip/WhiteClip authored in lighting_presets (ACES-fitted filmic curve)",
      "film_reference": {
        "FilmSlope": 0.88,
        "FilmToe": 0.55,
        "FilmShoulder": 0.26,
        "FilmBlackClip": 0.0,
        "FilmWhiteClip": 0.04
      },
      "ExpandGamut": 1.0,
      "BlueCorrection": 0.6,
      "ToneCurveAmount": 1.0,
      "cvars": {
        "r.Tonemapper.Quality": 5,
        "r.Tonemapper.Sharpen": "0.5 (live DefaultEngine)",
        "r.LUT.TonemappingMethod": -1
      }
    },
    "hdr_output": {
      "TonemappingMethod": "StandardACES",
      "cvars": {
        "r.AllowHDR": "1 (ini only)",
        "r.HDR.EnableHDROutput": 1,
        "r.HDR.Aces.Version": 2,
        "r.HDR.PaperWhite": 203,
        "r.HDR.Display.MaxLuminance": "from OS / user calibration",
        "r.HDR.Display.OverrideOSMaxLuminance": "only if the user calibrates"
      },
      "note": "Film* parameters do not apply to Standard ACES; grades still apply (pre-tonemap). The LUT is SDR-only."
    }
  },
