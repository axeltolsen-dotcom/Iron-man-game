{
  "metadata": {
    "name": "Vison camera shakes",
    "version": "1.0.0",
    "date": "2026-10-30",
    "generated_by": "gen_camera_realism.py",
    "classes": "CameraShakeBase (EngineCameras plugin) with RootShakePattern = PerlinNoiseCameraShakePattern / WaveOscillatorCameraShakePattern; several patterns -> CompositeCameraShakePattern (or one asset per pattern)",
    "units": {
      "location": "cm, camera-local X fwd / Y right / Z up",
      "rotation": "degrees (Pitch, Yaw, Roll)",
      "fov": "degrees",
      "Frequency_hz": "cycles per second (real units)",
      "Amplitude": "peak value of the oscillation (Perlin: bound - typical motion ~0.4-0.6 x)"
    },
    "ue_frequency_conversion": {
      "WaveOscillator": {
        "factor": 1.0,
        "rule": "ue_frequency = Frequency_hz (verified 2026-10-30 in UE 5.8 source: FWaveOscillator::Update does offset += dt * Frequency * 2*pi, so Frequency is already Hz)"
      },
      "PerlinNoise": {
        "factor": 1.66667,
        "rule": "ue_frequency = Frequency_hz / 0.6 (1D Perlin with unit lattice peaks near 0.6 cycles per unit)"
      },
      "verify": "Calibration: play CS_Calibration_1Hz (Wave pitch 1 deg @ 1 Hz) and count 10 peaks in 10 s; if you count ~63, the engine uses Hz - set factor 1.0 in this block and re-run apply."
    },
    "visibility_rules": {
      "min_visible_deg": 0.023,
      "max_frequency_hz_gameplay": 20.0,
      "why": "below ~0.5 px motion is lost under TSR; above fps/3 (20 Hz at 60 fps) oscillation aliases into a slower wobble"
    },
    "arenafeel": {
      "current": "trauma t in 0..1 decaying 1.6/s; offsets = t^2 * ima.ShakeScale * (pitch/yaw 2.4 deg, roll 3 deg, Y/Z 6 cm), Perlin at clock*22",
      "equivalence": "trauma_equivalent = sqrt(peak_pitch_deg / 2.4)",
      "integration": "pick ONE driver: either route ArenaFeel AddTrauma -> StartCameraShake(asset, scale) or keep trauma and use these values to retune it - never both at full strength"
    }
  },
  "accessibility": {
    "intensity_multiplier": {
      "range": [
        0.0,
        1.5
      ],
      "default": 1.0,
      "applies_to": "PlayerCameraManager::StartCameraShake Scale, PlayWorldCameraShake scale, ima.ShakeScale"
    },
    "presets": {
