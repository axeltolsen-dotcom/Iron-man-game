AI_LINE(Edith, DroneSwarm, "EDITH_droneSwarm_4", "", "Drones everywhere. All targeted. You're welcome.")
AI_LINE(Edith, TankSpotted, "EDITH_tankSpotted_1", "", "Tank spotted. Armor is thin at the rear.")
