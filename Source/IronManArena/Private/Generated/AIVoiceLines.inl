AI_LINE(Ultron, BossIncoming, "ULTRON_bossIncoming_2", "", "Big signature inbound, Axel. Don't hug it. Trust me.")
AI_LINE(Ultron, BossIncoming, "ULTRON_bossIncoming_3", "", "Their champion arrives. Let's disappoint it thoroughly.")
AI_LINE(Ultron, BossIncoming, "ULTRON_bossIncoming_4", "", "Brace yourself. This one actually thinks it can win.")
AI_LINE(Ultron, BossPhase2, "ULTRON_bossPhase2_1", "", "It's angry now. Good. Angry things make mistakes.")
AI_LINE(Ultron, BossPhase2, "ULTRON_bossPhase2_2", "", "Phase two. It's adapting, Axel. So do we.")
AI_LINE(Ultron, BossPhase2, "ULTRON_bossPhase2_3", "", "It's shedding armor. Exposed things bleed faster.")
AI_LINE(Ultron, BossPhase2, "ULTRON_bossPhase2_4", "", "Second wind for it. Last wind, if we're thorough.")
