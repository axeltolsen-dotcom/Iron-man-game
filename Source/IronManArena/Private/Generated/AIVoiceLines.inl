AI_LINE(WarMachine, ToFlight, "WARMACHINE_toFlight_2", "", "Going vertical. Air superiority mode.")
AI_LINE(WarMachine, ToFlight, "WARMACHINE_toFlight_3", "", "Wheels up. Eyes on the sky.")
AI_LINE(WarMachine, ToFlight, "WARMACHINE_toFlight_4", "", "Flight systems engaged. Climb, climb.")
AI_LINE(WarMachine, ToGround, "WARMACHINE_toGround_1", "", "Boots down. Ground assault mode.")
