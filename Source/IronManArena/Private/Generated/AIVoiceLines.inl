AI_LINE(Edith, ToGround, "EDITH_toGround_3", "", "Touchdown confirmed. The shadows favor us here.")
AI_LINE(Edith, ToGround, "EDITH_toGround_4", "", "Boots down. Wall-crawl available if needed.")
AI_LINE(Edith, HulkbusterReady, "EDITH_hulkbusterReady_1", "", "Hulkbuster charged. Subtlety optional from here, Axel.")
