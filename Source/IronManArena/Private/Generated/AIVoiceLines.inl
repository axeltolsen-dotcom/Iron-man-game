AI_LINE(WarMachine, LowEnergy, "WARMACHINE_lowEnergy_3", "", "Batteries bleeding out. Ration your shots.")
AI_LINE(WarMachine, LowEnergy, "WARMACHINE_lowEnergy_4", "", "Low power warning. Recommend resupply now.")
