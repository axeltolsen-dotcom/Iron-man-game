AI_LINE(Edith, WaveStart, "EDITH_waveStart_3", "", "Wave inbound. They still haven't spotted us.")
AI_LINE(Edith, WaveStart, "EDITH_waveStart_4", "", "Another wave. Their persistence is almost admirable.")
