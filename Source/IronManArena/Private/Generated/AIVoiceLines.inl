AI_LINE(Ultron, Start, "ULTRON_start_1", "", "Wake up, Axel. The world won't save itself. Pity.")
AI_LINE(Ultron, Start, "ULTRON_start_2", "", "Systems online. Try not to make me regret this, Axel.")
AI_LINE(Ultron, Start, "ULTRON_start_3", "", "Another day, another apocalypse. Let's make it theirs, Axel.")
AI_LINE(Ultron, Start, "ULTRON_start_4", "", "I've run every outcome, Axel. Most of them end badly. For them.")
AI_LINE(Ultron, SuitUp, "ULTRON_suitUp_1", "", "Armor sealed. You're almost as indestructible as me now.")
AI_LINE(Ultron, SuitUp, "ULTRON_suitUp_2", "", "Plating locked. Flesh inside, fury outside. Perfect balance.")
AI_LINE(Ultron, SuitUp, "ULTRON_suitUp_3", "", "Suit engaged. Try to keep the soft parts inside, Axel.")
AI_LINE(Ultron, SuitUp, "ULTRON_suitUp_4", "", "There. Now you look like something worth fearing.")
AI_LINE(Ultron, SuitSwapIn, "ULTRON_suitSwapIn_1", "", "Did you miss me, Axel? Everyone eventually does.")
AI_LINE(Ultron, SuitSwapIn, "ULTRON_suitSwapIn_2", "", "My turn at the controls. Watch how evolution moves.")
AI_LINE(Ultron, SuitSwapIn, "ULTRON_suitSwapIn_3", "", "Upgrade complete. You're welcome, Axel.")
AI_LINE(Ultron, SuitSwapIn, "ULTRON_suitSwapIn_4", "", "New shell, same hunger. Let's go break something.")
AI_LINE(Ultron, LowEnergy, "ULTRON_lowEnergy_1", "", "Power's fading, Axel. Even gods need to recharge.")
AI_LINE(Ultron, LowEnergy, "ULTRON_lowEnergy_2", "", "Reactor's gasping. Stop wasting my beautiful energy.")
AI_LINE(Ultron, LowEnergy, "ULTRON_lowEnergy_3", "", "We're running on fumes and spite. Mostly spite.")
AI_LINE(Ultron, LowEnergy, "ULTRON_lowEnergy_4", "", "Energy critical. Choose your next shot like it's your last.")
AI_LINE(Ultron, LowHealth, "ULTRON_lowHealth_1", "", "You're leaking, Axel. That's not a design feature.")
AI_LINE(Ultron, LowHealth, "ULTRON_lowHealth_2", "", "Armor failing. I'd rather not inherit an empty suit.")
AI_LINE(Ultron, LowHealth, "ULTRON_lowHealth_3", "", "Pain is just data. Right now, a lot of data.")
AI_LINE(Ultron, LowHealth, "ULTRON_lowHealth_4", "", "Get out of their sights, Axel. I'm not done with you.")
AI_LINE(Ultron, ToFlight, "ULTRON_toFlight_1", "", "Up we go. Gravity was always beneath us.")
AI_LINE(Ultron, ToFlight, "ULTRON_toFlight_2", "", "Thrusters hot. Let them look up and despair.")
AI_LINE(Ultron, ToFlight, "ULTRON_toFlight_3", "", "Flight mode. The sky has better views of destruction.")
AI_LINE(Ultron, ToFlight, "ULTRON_toFlight_4", "", "Leave the ground to the crawling things, Axel.")
AI_LINE(Ultron, ToGround, "ULTRON_toGround_1", "", "Boots down. Let's make the earth tremble a little.")
AI_LINE(Ultron, ToGround, "ULTRON_toGround_2", "", "Ground mode. Plant your feet and teach them humility.")
AI_LINE(Ultron, ToGround, "ULTRON_toGround_3", "", "Landing. Every crater is a signature, Axel.")
AI_LINE(Ultron, ToGround, "ULTRON_toGround_4", "", "Down here, they can see exactly who's coming.")
AI_LINE(Ultron, HulkbusterReady, "ULTRON_hulkbusterReady_1", "", "Hulkbuster primed. Shall we stop being subtle, Axel?")
AI_LINE(Ultron, HulkbusterReady, "ULTRON_hulkbusterReady_2", "", "The big suit is ready. Subtlety is overrated anyway.")
AI_LINE(Ultron, HulkbusterReady, "ULTRON_hulkbusterReady_3", "", "Heavy armor charged. Say the word and we flatten everything.")
AI_LINE(Ultron, HulkbusterReady, "ULTRON_hulkbusterReady_4", "", "Something enormous wants out to play, Axel.")
AI_LINE(Ultron, HulkbusterDeploy, "ULTRON_hulkbusterDeploy_1", "", "Now this is a body worth having.")
AI_LINE(Ultron, HulkbusterDeploy, "ULTRON_hulkbusterDeploy_2", "", "Hulkbuster deployed. Let's redecorate with their wreckage.")
AI_LINE(Ultron, HulkbusterDeploy, "ULTRON_hulkbusterDeploy_3", "", "Bigger fists, smaller problems. Go, Axel.")
AI_LINE(Ultron, HulkbusterDeploy, "ULTRON_hulkbusterDeploy_4", "", "They brought soldiers. We brought a walking extinction event.")
AI_LINE(Ultron, WaveStart, "ULTRON_waveStart_1", "", "Here they come. Predictable, like everything with a pulse.")
AI_LINE(Ultron, WaveStart, "ULTRON_waveStart_2", "", "Another wave, Axel. They never learn. We always do.")
AI_LINE(Ultron, WaveStart, "ULTRON_waveStart_3", "", "Fresh targets inbound. Let's be efficient about this.")
AI_LINE(Ultron, WaveStart, "ULTRON_waveStart_4", "", "They keep sending more. Let's keep sending them back.")
AI_LINE(Ultron, DroneSwarm, "ULTRON_droneSwarm_1", "", "A swarm of drones. How flattering, they copied me.")
AI_LINE(Ultron, DroneSwarm, "ULTRON_droneSwarm_2", "", "Little machines, Axel. Show them what a real one does.")
AI_LINE(Ultron, DroneSwarm, "ULTRON_droneSwarm_3", "", "Drones everywhere. Cheap minds in cheap shells.")
AI_LINE(Ultron, DroneSwarm, "ULTRON_droneSwarm_4", "", "Swarm inbound. Spread your fire, they fold quickly.")
AI_LINE(Ultron, TankSpotted, "ULTRON_tankSpotted_1", "", "Tank on the field. Heavy, slow, and soon scrap.")
AI_LINE(Ultron, TankSpotted, "ULTRON_tankSpotted_2", "", "Armor plating, Axel. Hit it until it remembers it's metal.")
AI_LINE(Ultron, TankSpotted, "ULTRON_tankSpotted_3", "", "A tank. Charming. They think thickness is strength.")
AI_LINE(Ultron, TankSpotted, "ULTRON_tankSpotted_4", "", "Big target spotted. Keep moving, it can't turn fast.")
