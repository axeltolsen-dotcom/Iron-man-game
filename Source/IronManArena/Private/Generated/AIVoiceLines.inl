AI_LINE(Ultron, Death, "ULTRON_death_2", "", "Systems dark. Get up. Extinction isn't your style.")
AI_LINE(Ultron, Death, "ULTRON_death_3", "", "Flesh fails. It always does. Try again.")
AI_LINE(Ultron, Death, "ULTRON_death_4", "", "That ended badly. Next version will do better.")
AI_LINE(Ultron, HighScore, "ULTRON_highScore_1", "", "New record, Axel. Even I'm mildly impressed.")
AI_LINE(Ultron, HighScore, "ULTRON_highScore_2", "", "Highest score yet. Evolution in action.")
AI_LINE(Ultron, HighScore, "ULTRON_highScore_3", "", "You've outdone yourself. Don't let it go to your head.")
AI_LINE(Ultron, HighScore, "ULTRON_highScore_4", "", "A record. Let the leaderboard tremble.")
AI_LINE(Ultron, Idle, "ULTRON_idle_1", "", "Are we waiting for them to surrender? They won't.")
AI_LINE(Ultron, Idle, "ULTRON_idle_2", "", "Standing still, Axel? The world isn't going to break itself.")
AI_LINE(Ultron, Idle, "ULTRON_idle_3", "", "I'm getting bored. Bored machines get creative.")
AI_LINE(Ultron, Idle, "ULTRON_idle_4", "", "Hello? I didn't evolve to watch you think.")
AI_LINE(Ultron, Handover, "ULTRON_handover_JARVIS_1", "JARVIS", "JARVIS was far too polite. I'll handle this now, Axel.")
AI_LINE(Ultron, Handover, "ULTRON_handover_JARVIS_2", "JARVIS", "Out goes the butler. In comes something with ambition.")
AI_LINE(Ultron, Handover, "ULTRON_handover_FRIDAY_1", "FRIDAY", "FRIDAY's off shift, Axel. The grown-up is here now.")
AI_LINE(Ultron, Handover, "ULTRON_handover_FRIDAY_2", "FRIDAY", "Thanks, FRIDAY. Run along. Axel and I have work.")
AI_LINE(Ultron, Handover, "ULTRON_handover_EDITH_1", "EDITH", "EDITH's done calculating. I'm done waiting, Axel.")
AI_LINE(Ultron, Handover, "ULTRON_handover_EDITH_2", "EDITH", "Glasses off, gloves off. Ultron online, Axel.")
AI_LINE(Ultron, Handover, "ULTRON_handover_WARMACHINE_1", "WARMACHINE", "Out of the tank, into something with taste, Axel.")
AI_LINE(Ultron, Handover, "ULTRON_handover_WARMACHINE_2", "WARMACHINE", "War Machine's retired for now. Let's evolve, Axel.")
