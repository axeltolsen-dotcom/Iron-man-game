AI_LINE(Edith, BossPhase2, "EDITH_bossPhase2_2", "", "Phase two, Axel. It's adapting. So am I.")
AI_LINE(Edith, BossPhase2, "EDITH_bossPhase2_3", "", "It's angrier now. Keep moving, stay low.")
AI_LINE(Edith, BossPhase2, "EDITH_bossPhase2_4", "", "New attack profile. Dodge first, admire later.")
