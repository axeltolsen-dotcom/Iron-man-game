AI_LINE(WarMachine, LowHealth, "WARMACHINE_lowHealth_2", "", "Hull failing. Get to cover, Axel.")
AI_LINE(WarMachine, LowHealth, "WARMACHINE_lowHealth_3", "", "Taking heavy damage. Need a medkit.")
AI_LINE(WarMachine, LowHealth, "WARMACHINE_lowHealth_4", "", "Integrity critical. Do not push forward.")
