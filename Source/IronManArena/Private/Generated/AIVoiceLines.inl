AI_LINE(Edith, BossPhase3, "EDITH_bossPhase3_2", "", "Phase three, Axel. Missiles first, swarm behind.")
AI_LINE(Edith, BossPhase3, "EDITH_bossPhase3_3", "", "Desperation detected. Finish this cleanly.")
AI_LINE(Edith, BossPhase3, "EDITH_bossPhase3_4", "", "Last stand. Their odds are worse than ours.")
AI_LINE(Edith, BossDefeated, "EDITH_bossDefeated_1", "", "Target neutralized. Efficient work, Axel.")
AI_LINE(Edith, BossDefeated, "EDITH_bossDefeated_2", "", "Boss down. I'll log that as a lesson.")
AI_LINE(Edith, BossDefeated, "EDITH_bossDefeated_3", "", "Threat eliminated. The cloak barely needed to try.")
AI_LINE(Edith, BossDefeated, "EDITH_bossDefeated_4", "", "Down it goes. Filing the report already.")
AI_LINE(Edith, Combo, "EDITH_combo_1", "", "Chain sustained. Precise, if a little showy.")
AI_LINE(Edith, Combo, "EDITH_combo_2", "", "Combo climbing, Axel. Don't stop now.")
AI_LINE(Edith, Combo, "EDITH_combo_3", "", "Multiple confirmed hits. Statistically impressive.")
AI_LINE(Edith, Combo, "EDITH_combo_4", "", "Excellent chain. Updating your threat rating.")
AI_LINE(Edith, PickupHealth, "EDITH_pickupHealth_1", "", "Repair kit absorbed. Nanoweave knitting closed.")
AI_LINE(Edith, PickupHealth, "EDITH_pickupHealth_2", "", "Armor patched, Axel. Try to keep it.")
AI_LINE(Edith, PickupHealth, "EDITH_pickupHealth_3", "", "Integrity restored. Breaches sealed.")
AI_LINE(Edith, PickupHealth, "EDITH_pickupHealth_4", "", "Hull repaired. Please don't test it immediately.")
AI_LINE(Edith, PickupEnergy, "EDITH_pickupEnergy_1", "", "Energy cell absorbed. Cloak back to full.")
AI_LINE(Edith, PickupEnergy, "EDITH_pickupEnergy_2", "", "Power restored, Axel. Spend it wisely.")
AI_LINE(Edith, PickupEnergy, "EDITH_pickupEnergy_3", "", "Reactor topped up. Shadows available again.")
AI_LINE(Edith, PickupEnergy, "EDITH_pickupEnergy_4", "", "Charge acquired. The thrusters thank you.")
AI_LINE(Edith, PickupHulkbuster, "EDITH_pickupHulkbuster_1", "", "Hulkbuster core collected. Charge rising.")
AI_LINE(Edith, PickupHulkbuster, "EDITH_pickupHulkbuster_2", "", "Heavy frame energy logged, Axel.")
AI_LINE(Edith, PickupHulkbuster, "EDITH_pickupHulkbuster_3", "", "Hulkbuster fragment secured. Getting closer.")
AI_LINE(Edith, PickupHulkbuster, "EDITH_pickupHulkbuster_4", "", "Core acquired. The big suit approves.")
AI_LINE(Edith, Death, "EDITH_death_1", "", "Suit failure. Recovering what I can, Axel.")
AI_LINE(Edith, Death, "EDITH_death_2", "", "Systems offline. That was not the plan.")
AI_LINE(Edith, Death, "EDITH_death_3", "", "Critical loss. I'll have a better strategy next time.")
AI_LINE(Edith, Death, "EDITH_death_4", "", "Signal fading. Get up, Axel. Please.")
AI_LINE(Edith, HighScore, "EDITH_highScore_1", "", "New high score. I've saved the replay, Axel.")
AI_LINE(Edith, HighScore, "EDITH_highScore_2", "", "Record broken. Updating the leaderboard quietly.")
AI_LINE(Edith, HighScore, "EDITH_highScore_3", "", "Best run logged. Even I'm mildly impressed.")
AI_LINE(Edith, HighScore, "EDITH_highScore_4", "", "Top score, Axel. Statistically, you're getting dangerous.")
AI_LINE(Edith, Idle, "EDITH_idle_1", "", "Holding position. The cloak is getting bored.")
AI_LINE(Edith, Idle, "EDITH_idle_2", "", "All quiet, Axel. I'm still scanning.")
AI_LINE(Edith, Idle, "EDITH_idle_3", "", "Standing by. Spider-legs twitching slightly.")
AI_LINE(Edith, Idle, "EDITH_idle_4", "", "No contacts. Enjoy it while it lasts.")
AI_LINE(Edith, Handover, "EDITH_handover_JARVIS_1", "JARVIS", "JARVIS has the night off. EDITH online, Axel.")
AI_LINE(Edith, Handover, "EDITH_handover_JARVIS_2", "JARVIS", "Thank you, JARVIS. Switching to stealth protocols.")
AI_LINE(Edith, Handover, "EDITH_handover_FRIDAY_1", "FRIDAY", "FRIDAY's off comms. EDITH has tactical, Axel.")
AI_LINE(Edith, Handover, "EDITH_handover_FRIDAY_2", "FRIDAY", "Thanks, FRIDAY. Going quiet now, Axel.")
AI_LINE(Edith, Handover, "EDITH_handover_ULTRON_1", "ULTRON", "Ultron purged. Your suit is yours again, Axel.")
AI_LINE(Edith, Handover, "EDITH_handover_ULTRON_2", "ULTRON", "Ultron's ambitions deleted. Mine are simply efficient.")
