AI_LINE(Edith, HulkbusterDeploy, "EDITH_hulkbusterDeploy_4", "", "Docking complete. Everything nearby is now fragile.")
AI_LINE(Edith, WaveStart, "EDITH_waveStart_1", "", "New wave detected. Targets tagged and sorted.")
