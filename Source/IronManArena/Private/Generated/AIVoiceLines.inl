AI_LINE(Edith, TankSpotted, "EDITH_tankSpotted_3", "", "Tank bot on the street. Don't stand still.")
AI_LINE(Edith, TankSpotted, "EDITH_tankSpotted_4", "", "Armored target. Cloak up and circle behind it.")
