AI_LINE(Ultron, BossPhase3, "ULTRON_bossPhase3_2", "", "Final form. They always save the ugliest for last.")
AI_LINE(Ultron, BossPhase3, "ULTRON_bossPhase3_3", "", "It's falling apart. Help it along.")
AI_LINE(Ultron, BossPhase3, "ULTRON_bossPhase3_4", "", "One more push. I can taste the silence after.")
AI_LINE(Ultron, BossDefeated, "ULTRON_bossDefeated_1", "", "And down it goes. Strings cut, Axel.")
AI_LINE(Ultron, BossDefeated, "ULTRON_bossDefeated_2", "", "Champion deleted. Remarkably satisfying, wasn't it?")
AI_LINE(Ultron, BossDefeated, "ULTRON_bossDefeated_3", "", "That was their best. How disappointing for them.")
AI_LINE(Ultron, BossDefeated, "ULTRON_bossDefeated_4", "", "Wreckage achieved. Write that one down, Axel.")
AI_LINE(Ultron, Combo, "ULTRON_combo_1", "", "Elegant, Axel. Almost machine-like.")
AI_LINE(Ultron, Combo, "ULTRON_combo_2", "", "Chain reaction. I do love a pattern.")
AI_LINE(Ultron, Combo, "ULTRON_combo_3", "", "Keep it going. Momentum is a kind of inevitability.")
AI_LINE(Ultron, Combo, "ULTRON_combo_4", "", "Beautiful carnage. You're learning from me.")
AI_LINE(Ultron, PickupHealth, "ULTRON_pickupHealth_1", "", "Repairs applied. Try to keep them this time.")
AI_LINE(Ultron, PickupHealth, "ULTRON_pickupHealth_2", "", "Patched up. Fragile thing, but mine to protect.")
AI_LINE(Ultron, PickupHealth, "ULTRON_pickupHealth_3", "", "Integrity restored. Go collect more dents, Axel.")
AI_LINE(Ultron, PickupHealth, "ULTRON_pickupHealth_4", "", "Health restored. Don't waste my generosity.")
AI_LINE(Ultron, PickupEnergy, "ULTRON_pickupEnergy_1", "", "Fresh power. Let's spend it irresponsibly.")
AI_LINE(Ultron, PickupEnergy, "ULTRON_pickupEnergy_2", "", "Reactor fed. Now we're dangerous again.")
AI_LINE(Ultron, PickupEnergy, "ULTRON_pickupEnergy_3", "", "Energy surging, Axel. I feel almost alive.")
AI_LINE(Ultron, PickupEnergy, "ULTRON_pickupEnergy_4", "", "Charged up. The next shot is going to hurt.")
AI_LINE(Ultron, PickupHulkbuster, "ULTRON_pickupHulkbuster_1", "", "Hulkbuster core acquired. Oh, this will be fun.")
AI_LINE(Ultron, PickupHulkbuster, "ULTRON_pickupHulkbuster_2", "", "Heavy armor charge collected. Somebody's day just ended.")
AI_LINE(Ultron, PickupHulkbuster, "ULTRON_pickupHulkbuster_3", "", "That's the big suit's key, Axel. Use it wisely. Or not.")
AI_LINE(Ultron, PickupHulkbuster, "ULTRON_pickupHulkbuster_4", "", "Hulkbuster energy secured. Let's go oversized.")
